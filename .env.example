# Copy to .env.local for local development, or set these in your Vercel
# project's Environment Variables. Never commit real values.

# Required for BitForge AI (the chat assistant) to work at all.
# Get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model used by /api/chat. Defaults to
# gemini-3.5-flash-lite (a current, stable GA model) if unset. Google
# regularly deprecates model IDs — check https://ai.google.dev/gemini-api/docs/deprecations
# before assuming the default is still valid, and prefer a stable GA model
# over an experimental/preview one for production use.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Required for rate limiting on /api/chat. Free tier is enough — create a
# database at https://console.upstash.com/redis and copy the REST URL/token.
# If these are left unset entirely, the AI endpoint intentionally runs
# without rate limiting (useful for local development). If they ARE set but
# Upstash becomes unreachable at request time, /api/chat fails closed
# (rejects the request with a 503) rather than letting it through unmetered.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
